# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Mac
.DS_Store

# Data and models
data/raw/*
data/processed/*
models/*
outputs/figures/*
outputs/reports/*

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!outputs/figures/.gitkeep
!outputs/reports/.gitkeep

# Track the production model artifact, its metadata, and the
# portfolio-facing figures/reports. Large per-row prediction dumps and
# the raw generated dataset stay untracked (regenerable, not needed to
# review the project).
!models/model.joblib
!models/model_metadata.json
!outputs/figures/*.png
!outputs/reports/*.md
!outputs/reports/*.csv